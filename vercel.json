{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path=/$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.py?__path=/health"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
